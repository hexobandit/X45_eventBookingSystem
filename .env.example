# Copy to .env and fill in. Never commit .env.

# 'development' | 'production' | 'testing'
FLASK_CONFIG=development

# REQUIRED in production — generate with: python -c "import secrets; print(secrets.token_hex(32))"
# NOTE: the SMTP password stored via the admin Email Settings page is encrypted
# with a key derived from SECRET_KEY — rotating SECRET_KEY invalidates it and
# it must be re-entered in the admin.
SECRET_KEY=

# REQUIRED in production — PostgreSQL, e.g. postgresql://courses:password@localhost:5432/courses
# Development falls back to sqlite:///dev.db when unset.
DATABASE_URL=

# Public domain used in emails, sitemap, canonical/OG tags
CANONICAL_DOMAIN=http://127.0.0.1:5000

# Google Analytics 4 measurement id (leave empty to disable the tag)
GA4_ID=

# Optional: Stripe card payments — leave empty to hide the card option entirely.
# Secret key from Dashboard > Developers > API keys (sk_test_... in test mode,
# sk_live_... in production).
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_...) for the /webhooks/stripe endpoint.
# Local dev: stripe listen --forward-to localhost:5000/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# Optional: Redis for rate limiting across multiple gunicorn workers
# REDIS_URL=redis://localhost:6379/0

# Branding — every value optional; defaults describe the fictional demo
# organisation (see app/branding.py). Set these per client deployment.
BRAND_SITE_NAME=
BRAND_SITE_TAGLINE=
BRAND_SITE_DESCRIPTION=
BRAND_SITE_TITLE_SUFFIX=
BRAND_AUTHORS=            # comma-separated, e.g. "Jana Nováková, Petr Král"
BRAND_CITY=
BRAND_EMAIL_SIGNATURE=
BRAND_EMAIL_SIGNATURE_HTML=
BRAND_PAYMENT_BENEFICIARY=
BRAND_INSTAGRAM_URL=
BRAND_INSTAGRAM_HANDLE=

# Public demo instance (see README "Demo mode"). The credentials are only
# displayed/typed for visitors — create the user with `flask create-admin`.
DEMO_MODE=0
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=
